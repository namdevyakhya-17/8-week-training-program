class Solution {
    public boolean dfs(int i, List<List<Integer>> graph, boolean[] visited, boolean[] samePath){
        visited[i] = true;
        samePath[i] = true;
        for(int v: graph.get(i)){
            if(!visited[v]){
                if(dfs(v,graph,visited,samePath)) return true;
            }else{
                if(samePath[v]) return true;
            }
        }
        
        samePath[i] = false;
        return false;
    }
    public boolean isCyclic(int V, int[][] edges) {
        // code here
        List<List<Integer>> graph = new ArrayList<>();
        for(int i=0; i<V; i++){
            graph.add(new ArrayList<>());
        }
        for(int[] edge: edges){
            int u = edge[0];
            int v = edge[1];
            graph.get(u).add(v);
        }
        
        boolean[] visited = new boolean[V];
        boolean[] samePath = new boolean[V];
        for(int i=0; i<V; i++){
            if(!visited[i]){
                if(dfs(i,graph,visited,samePath)) return true;
            }
        }
        return false;
    }
}
