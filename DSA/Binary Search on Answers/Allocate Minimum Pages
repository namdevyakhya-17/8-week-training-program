class Solution {
    public int findPages(int[] arr, int k) {
        if(arr.length < k) return -1;
        int min = 0;
        int max = 0;
        
        for(int num: arr){
            max += num;
            min = Math.max(min, num);
        }
        if(k == 1) return max;
        
        int pages = findPages(arr, min, max, k);
        return pages;
    }
    
    public int findPages(int[] arr, int min, int max, int k){
        int maxPage = max;
        
        while(min <= max){
            int mid = (min+max)/2;
            int person = 1;
            int page = 0;
            for(int i=0; i<arr.length; i++){
                if(arr[i] > mid) continue;
                
                page += arr[i];
                if(page > mid){
                    person++;
                    page = arr[i];
                }
            }
            
            if(person <= k){
                maxPage = mid;
                max = mid-1;
            }else{
                min = mid+1;
            }
        }
        return maxPage;
    }
}
